# Bản mẫu cho môi trường khác; render.env hiện được phép commit theo yêu cầu chủ đồ án.
# Render → Environment → Add from .env. Thay placeholder trước khi import.
SPRING_PROFILES_ACTIVE=prod
PORT=10000
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_NEON_DIRECT_HOST/neondb?sslmode=require&channelBinding=require&currentSchema=tank_battle
SPRING_DATASOURCE_USERNAME=YOUR_DATABASE_USER
SPRING_DATASOURCE_PASSWORD=YOUR_DATABASE_PASSWORD
SPRING_FLYWAY_URL=jdbc:postgresql://YOUR_NEON_DIRECT_HOST/neondb?sslmode=require&channelBinding=require&currentSchema=tank_battle
AUTH_ISSUER=https://tank-battle-web.onrender.com
JWT_PRIVATE_KEY=file:/etc/secrets/jwt-private.pem
JWT_PUBLIC_KEY=file:/etc/secrets/jwt-public.pem
JWT_KEY_ID=tank-v1
DB_POOL_SIZE=5
API_DOCS_ENABLED=true
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD_AT_LEAST_12_CHARACTERS

# Chưa cấu hình Google thì giữ profile prod. Khi đã có OAuth Client, đổi thành prod,google
# và thêm GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET trong Render Dashboard.
