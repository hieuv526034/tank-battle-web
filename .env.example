# Mẫu chạy trên máy phát triển; Spring đọc .env từ working directory của project.
# Cùng profile prod/PostgreSQL; không có H2/local runtime. Start sẽ chạy Flyway trên DB đã chọn.
# Dùng KEY=VALUE nguyên bản, không thêm export/dấu nháy hoặc lệnh shell.
SPRING_DATASOURCE_URL=jdbc:postgresql://YOUR_NEON_DIRECT_HOST/neondb?sslmode=require&channelBinding=require&currentSchema=tank_battle
SPRING_DATASOURCE_USERNAME=YOUR_DATABASE_USER
SPRING_DATASOURCE_PASSWORD=YOUR_DATABASE_PASSWORD
# Cùng direct endpoint/database/schema cho Flyway; Hikari tự giới hạn pool của app.
SPRING_FLYWAY_URL=jdbc:postgresql://YOUR_NEON_DIRECT_HOST/neondb?sslmode=require&channelBinding=require&currentSchema=tank_battle
AUTH_ISSUER=http://localhost:8080
JWT_PRIVATE_KEY=file:./secrets/jwt-private.pem
JWT_PUBLIC_KEY=file:./secrets/jwt-public.pem
# Chỉ cho HTTP trên máy phát triển; Render dùng render.env và mặc định secure=true.
AUTH_SECURE_COOKIE=false
SESSION_SECURE_COOKIE=false
DB_POOL_SIZE=5
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD_AT_LEAST_12_CHARACTERS
# Trên Render đặt prod; chỉ thêm ,google khi có đủ GOOGLE_CLIENT_ID/GOOGLE_CLIENT_SECRET.
# SPRING_PROFILES_ACTIVE=prod
# API_DOCS_ENABLED=true
